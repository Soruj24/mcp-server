{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",      /* Where your source code lives */
    "outDir": "./dist",      /* Where compiled JavaScript goes */
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
